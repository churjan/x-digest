---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrowseShell from '../components/BrowseShell.astro';
import DigestArticle from '../components/DigestArticle.astro';
import Pager from '../components/Pager.astro';
import { getDigests, neighbors, type Digest } from '../lib/digests';
import { formatDateId } from '../lib/dates';
import { DATE_ID } from '../lib/site';

export async function getStaticPaths() {
  const digests = await getDigests();
  return digests
    .filter((digest) => DATE_ID.test(digest.id))
    .map((digest) => ({
      params: { date: digest.id },
      props: { digest },
    }));
}

interface Props {
  digest: Digest;
}

const { digest } = Astro.props;
const digests = await getDigests();
const { newer, older } = neighbors(digests, digest.id);
---

<BaseLayout title={formatDateId(digest.id)} description={digest.data.lead}>
  <BrowseShell currentDate={digest.id}>
    <main id="content">
      <DigestArticle digest={digest} />
      <Pager newer={newer} older={older} latestId={digests[0]?.id} />
    </main>
  </BrowseShell>
</BaseLayout>

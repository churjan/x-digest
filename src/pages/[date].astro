---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import DigestArticle from '../components/DigestArticle.astro';
import DateSidebar from '../components/DateSidebar.astro';
import { getDigests, type Digest } from '../lib/digests';
import { formatDateId } from '../lib/dates';
import { DATE_ID } from '../lib/site';

export async function getStaticPaths() {
  const digests = await getDigests();
  return digests
    .filter((digest) => DATE_ID.test(digest.id))
    .map((digest) => ({
      params: { date: digest.id },
      props: { digest },
    }));
}

interface Props {
  digest: Digest;
}

const { digest } = Astro.props;
const digests = await getDigests();
---

<BaseLayout title={formatDateId(digest.id)} description={digest.data.lead}>
  <main id="content" class="wrap reading-layout">
    <DateSidebar digests={digests} selected={digest.id} />
    <div class="reading-column">
      <DigestArticle digest={digest} />
    </div>
  </main>
  <Footer />
</BaseLayout>

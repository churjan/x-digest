---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DigestArticle from '../components/DigestArticle.astro';
import DateSidebar from '../components/DateSidebar.astro';
import { getDigests, getLatestDigest } from '../lib/digests';
import { SITE } from '../lib/site';

const latest = await getLatestDigest();
const digests = await getDigests();
---

<BaseLayout description={latest?.data.lead ?? SITE.description}>
  {!latest && <Header />}
  <main id="content" class="wrap reading-layout">
    {
      latest ? (
        <>
          <DateSidebar digests={digests} selected={latest.id} />
          <div class="reading-column">
            <DigestArticle digest={latest} />
          </div>
        </>
      ) : (
        <p class="empty">还没有早报。运行 <code>npm run new</code> 创建第一期。</p>
      )
    }
  </main>
  <Footer />
</BaseLayout>

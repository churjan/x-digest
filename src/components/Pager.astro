---
import type { Digest } from '../lib/digests';
import { browseHref } from '../lib/browse';
import { shortDateId } from '../lib/dates';
import type { CategorySlug } from '../lib/site';

interface Props {
  newer?: Digest;
  older?: Digest;
  category?: CategorySlug;
  latestId?: string;
}

const { newer, older, category, latestId } = Astro.props;
---

<nav class="pager" aria-label="上下期">
  <span>
    {
      older ? (
        <a href={browseHref(older.id, category, latestId)}>← {shortDateId(older.id)}</a>
      ) : (
        <span>已是最早一期</span>
      )
    }
  </span>
  <span>
    {
      newer ? (
        <a href={browseHref(newer.id, category, latestId)}>{shortDateId(newer.id)} →</a>
      ) : (
        <span>已是最新一期</span>
      )
    }
  </span>
</nav>

---
import type { Digest } from '../lib/digests';
import { shortDateId } from '../lib/dates';

interface Props {
  newer?: Digest;
  older?: Digest;
}

const { newer, older } = Astro.props;
---

<nav class="pager" aria-label="上下期">
  <span>
    {
      older ? (
        <a href={`/${older.id}`}>← {shortDateId(older.id)}</a>
      ) : (
        <span>已是最早一期</span>
      )
    }
  </span>
  <span>
    {
      newer ? (
        <a href={`/${newer.id}`}>{shortDateId(newer.id)} →</a>
      ) : (
        <span>已是最新一期</span>
      )
    }
  </span>
</nav>

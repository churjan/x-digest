---
import { formatDateId } from '../lib/dates';
import { parseDigestBody, sectionsForCategory } from '../lib/browse';
import { categoryBySlug, type CategorySlug } from '../lib/site';
import type { Digest } from '../lib/digests';

interface Props {
  digest: Digest;
  latest?: boolean;
  category?: CategorySlug;
}

const { digest, latest = false, category } = Astro.props;
const allSections = parseDigestBody(digest.body);
const sections = sectionsForCategory(allSections, category);
const selected = category ? categoryBySlug(category) : undefined;
---

<article class="digest">
  <header class="digest-head page-head">
    {latest && !category && <p class="kicker">最新一期</p>}
    {selected && <p class="kicker">{selected.label}</p>}
    <h1>{formatDateId(digest.id)}</h1>
    {digest.data.lead && !category && <p class="lead">{digest.data.lead}</p>}
  </header>
  <div class="digest-body">
    {
      sections.length === 0 ? (
        <p class="empty">
          {selected
            ? `这一期没有「${selected.label}」。切换到全部，或换一个日期。`
            : '这一期还没有条目。'}
        </p>
      ) : (
        sections.map((section) => (
          <section id={section.slug}>
            {!category && (
              <h2 class:list={{ latin: /^[A-Za-z0-9]+$/.test(section.heading) }}>{section.heading}</h2>
            )}
            {section.items.length === 0 ? (
              <p class="empty">暂无条目。</p>
            ) : (
              <ol>
                {section.items.map((item) => (
                  <li>
                    <p>
                      <strong>{item.title}</strong>
                      {item.summary ? ` — ${item.summary}` : ''}
                      {item.href && (
                        <>
                          {' '}
                          <a href={item.href} rel="noopener noreferrer">
                            原文
                          </a>
                        </>
                      )}
                    </p>
                  </li>
                ))}
              </ol>
            )}
          </section>
        ))
      )
    }
  </div>
</article>
